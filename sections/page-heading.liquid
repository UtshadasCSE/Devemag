{% assign background_color = section.settings.section_color_scheme.settings.background %}
{% assign title_color = section.settings.section_color_scheme.settings.text %}
{% assign description_color = section.settings.section_color_scheme.settings.subtext %}

{% schema %}
{
  "name": "Page Heading",
  "tag": "section",
  "class": "page-heading-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About us"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Your Digital Journey Starts Here: Dive into Our Expertise.</p>"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 800
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "bottom_radius",
      "min": 5,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom Corner",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Page Heading",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<style>
  .page-heading-section {
    background:{{background_color}};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-bottom-left-radius: {{ section.settings.bottom_radius }}px;
    border-bottom-right-radius: {{ section.settings.bottom_radius }}px;
    text-align: center;
  }

  .page-heading-container {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .page-heading-title {
    font-size: 2.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
    color: {{ title_color }};
  }

  .page-heading-description {
    font-size: 1.2rem;
    line-height: 1.5;
    color: {{description_color}};
  }

  @media screen and (max-width: 768px) {
    .page-heading-title {
      font-size: 2rem;
    }

    .page-heading-description {
      font-size: 1rem;
    }
  }
</style>

<div class="page-heading-section">
  <div class="page-heading-container">
    {% if section.settings.heading != blank %}
      <h2 class="page-heading-title">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="page-heading-description">{{ section.settings.description }}</div>
    {% endif %}
  </div>
</div>
