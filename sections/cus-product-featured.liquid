    },
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card Color Scheme",
      "default": "scheme-2"
    },

    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "text",
      "id": "card_1_icon",
      "label": "Card Icon (Emoji or Unicode)",
      "default": "Settings"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Heading",
      "default": "Natural"
    },
    {
      "type": "textarea",
      "id": "card_1_text",
      "label": "Description",
      "default": "Compliment interested discretion estimating."
    },
    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "text",
      "id": "card_2_icon",
      "label": "Card Icon (Emoji or Unicode)",
      "default": "Saw"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Heading",
      "default": "Natural"
    },
    {
      "type": "textarea",
      "id": "card_2_text",
      "label": "Description",
      "default": "Compliment interested discretion estimating."
    },
    {
      "type": "header",
      "content": "Card 3"
    },
    {
      "type": "text",
      "id": "card_3_icon",
      "label": "Card Icon (Emoji or Unicode)",
      "default": "Briefcase"
    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Heading",
      "default": "100% Organic"
    },
    {
      "type": "textarea",
      "id": "card_3_text",
      "label": "Description",
      "default": "Never at water me might. On formed merits hunted."
    }
  ],
  "presets": [
    {
      "name": "Featured Product Showcase",
      "category": "Custom"
    }
  ]
}
{% endschema %}
