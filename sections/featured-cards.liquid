<section class="fc-product-cards-section" style="background-color: {{ section.settings.section_bg }};">
  <div class="fc-product-cards-container">
    {% if section.blocks.size > 0 %}
      <div class="fc-cards-grid">
        {% for block in section.blocks %}
          <div class="fc-card" style="background-color: {{ block.settings.card_bg }};">
            <div class="fc-image-container">
              {% if block.settings.card_image %}
                <img
                  src="{{ block.settings.card_image | image_url: width: 1500 }}"
                  alt="{{ block.settings.heading }}"
                  loading="lazy"
                  height="300"
                  width="400"
                >
              {% else %}
                <div class="fc-image-placeholder"></div>
              {% endif %}
              {% if block.settings.show_badge %}
                <div class="fc-badge">
                  <div class="fc-badge-icon">{{ block.settings.badge_title }}</div>
                </div>
              {% endif %}
            </div>

            <div class="fc-content">
              {% if block.settings.sub_heading %}
                <div class="fc-doctor-name" style="color: {{ block.settings.text_color }};">
                  {{ block.settings.sub_heading }}
                </div>
              {% endif %}

              <h3 class="fc-title" style="color: {{ block.settings.text_color }};">
                {{ block.settings.heading }}
              </h3>

              <p class="fc-description" style="color: {{ block.settings.description_color }};">
                {{ block.settings.description }}
              </p>

              {% if block.settings.button_label and block.settings.button_link %}
                <a
                  href="{{ block.settings.button_link }}"
                  class="fc-btn"
                  style="background-color: {{ block.settings.button_bg }};"
                >
                  <span>{{ block.settings.button_label }}</span>
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="fc-placeholder-text">Add cards to get started</p>
    {% endif %}
  </div>
</section>

<style>
  .fc-product-cards-section {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    transition: background-color 0.3s ease;
  }

  .fc-product-cards-container {
    max-width: 1320px;
    margin: 0 auto;
  }

  .fc-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    width: 100%;
  }

  .fc-card {
    border-radius: 20px;
    box-shadow: 0 5px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .fc-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 25px rgba(0, 0, 0, 0.15);
  }

  .fc-image-container {
    position: relative;
    width: 100%;
    padding-bottom: 75%;
    overflow: hidden;
    background: #f0f0f0;
  }

  .fc-image-container img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .fc-image-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e0e7ff 0%, #f3e8ff 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 14px;
  }

  .fc-card:hover .fc-image-container img {
    transform: scale(1.05);
  }

  .fc-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fc-pulse 2s infinite;
    z-index: 2;
  }

  @keyframes fc-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  .fc-badge-icon {
    width: 100px;
    height: 30px;
    background: linear-gradient(135deg, #ffffff 0%, #ffffff 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: #000000;
    font-weight: bold;
  }

  .fc-content {
    padding: 30px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .fc-doctor-name {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .fc-title {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 15px;
    line-height: 1.3;
  }

  .fc-description {
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: auto;
    padding-bottom: 20px;
  }

  .fc-btn {
    display: inline-block;
    width: 100%;
    color: white;
    border: none;
    padding: 14px 20px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    text-align: center;
    text-decoration: none;
    font-family: inherit;
  }

  .fc-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .fc-btn:hover::before {
    width: 300px;
    height: 300px;
  }

  .fc-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  }

  .fc-btn:active {
    transform: translateY(0);
  }

  .fc-btn span {
    position: relative;
    z-index: 1;
  }

  .fc-placeholder-text {
    text-align: center;
    color: #999;
    padding: 40px 20px;
    font-size: 16px;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .fc-cards-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }
  }

  @media (max-width: 768px) {
    .fc-product-cards-section {
      padding: {{ section.settings.padding_top | divided_by: 1.5 | round }}px 16px {{ section.settings.padding_bottom | divided_by: 1.5 | round }}px;
    }

    .fc-cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .fc-card {
      max-width: 100%;
    }

    .fc-content {
      padding: 24px;
    }

    .fc-title {
      font-size: 20px;
    }

    .fc-description {
      font-size: 14px;
    }
  }

  @media (max-width: 480px) {
    .fc-product-cards-section {
      padding: 20px 12px;
    }

    .fc-cards-grid {
      gap: 16px;
    }

    .fc-badge {
      width: 60px;
      height: 60px;
    }

    .fc-badge-icon {
      width: 44px;
      height: 44px;
      font-size: 20px;
    }

    .fc-content {
      padding: 20px;
    }

    .fc-doctor-name {
      font-size: 11px;
    }

    .fc-title {
      font-size: 18px;
      margin-bottom: 12px;
    }

    .fc-description {
      font-size: 13px;
      margin-bottom: 15px;
      padding-bottom: 15px;
    }

    .fc-btn {
      padding: 12px 16px;
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Cards",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    { "type": "color", "id": "section_bg", "label": "Section Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "card_image", "label": "Card Image" },
        { "type": "text", "id": "badge_title", "label": "Badge Title", "default": "Title" },
        { "type": "text", "id": "sub_heading", "label": "Sub Heading", "default": "Featured Product" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Card Title" },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Add a compelling description for your product or service here."
        },
        { "type": "text", "id": "button_label", "label": "Button Label", "default": "View Products" },
        { "type": "url", "id": "button_link", "label": "Button Link" },
        { "type": "checkbox", "id": "show_badge", "label": "Show Badge", "default": true },
        { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#ffffff" },
        { "type": "color", "id": "text_color", "label": "Card Text Color", "default": "#2d3748" },
        { "type": "color", "id": "description_color", "label": "Description Color", "default": "#718096" },
        { "type": "color", "id": "button_bg", "label": "Button Background", "default": "#2d3748" }
      ]
    }
  ],
  "presets": [{ "name": "Featured Cards", "category": "Custom", "blocks": [{ "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
