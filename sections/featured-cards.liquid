{% comment %}
  ==============================================================================
  SECTION: FEATURED CARDS
  ==============================================================================
  Description:
    A flexible, responsive grid section designed to feature multiple product,
    service, or content cards.
    - Each card is a customizable block, including its own image, badge, text, and button.
    - Uses a dedicated color scheme for the main section background.
    - Each individual card can use its own unique color scheme.
{% endcomment %}

<section
  class="fc-product-cards-section"
  style="background-color: {{ section.settings.section_color_scheme.settings.background }};"
>
  <div class="fc-product-cards-container">
    {% if section.blocks.size > 0 %}
      {% comment %} Grid container for the cards {% endcomment %}
      <div class="fc-cards-grid">
        {% comment %} Loop through each card block added in the theme editor {% endcomment %}
        {% for block in section.blocks %}
          {%- liquid
            assign card_scheme = block.settings.card_color_scheme
            assign btn_bg = card_scheme.settings.button
            assign btn_text = card_scheme.settings.button_label
          -%}

          {% comment %} Individual Card HTML structure {% endcomment %}
          <div
            class="fc-card"
            style="background-color: {{ card_scheme.settings.background }};"
            {{ block.shopify_attributes }}
          >
            {% comment %} Card Image and Badge Container {% endcomment %}
            <div class="fc-image-container">
              {% if block.settings.card_image %}
                <img
                  src="{{ block.settings.card_image | image_url: width: 1500 }}"
                  alt="{{ block.settings.heading | escape }}"
                  loading="lazy"
                  height="300"
                  width="400"
                >
              {% else %}
                {% comment %} Placeholder if no image is set {% endcomment %}
                <div class="fc-image-placeholder"></div>
              {% endif %}

              {% comment %} Optional Badge/Tag element (Show only if checkbox is checked) {% endcomment %}
              {% if block.settings.show_badge %}
                <div class="fc-badge">
                  <div class="fc-badge-icon">{{ block.settings.badge_title }}</div>
                </div>
              {% endif %}
            </div>

            {% comment %} Card Text Content Area {% endcomment %}
            <div class="fc-content">
              {% comment %} Sub-Heading/Doctor Name (uses main text color from card scheme) {% endcomment %}
              {% if block.settings.sub_heading %}
                <div class="fc-doctor-name" style="color: {{ card_scheme.settings.text }};">
                  {{ block.settings.sub_heading }}
                </div>
              {% endif %}

              {% comment %} Main Heading (uses main text color from card scheme) {% endcomment %}
              <h3 class="fc-title" style="color: {{ card_scheme.settings.text }};">
                {{ block.settings.heading }}
              </h3>

              {% comment %} Description/Paragraph (uses secondary text color from card scheme) {% endcomment %}
              <p class="fc-description" style="color: {{ card_scheme.settings.secondary_text }};">
                {{ block.settings.description }}
              </p>

              {% comment %} Call-to-Action Button (Only render if both label and link are set) {% endcomment %}
              {% if block.settings.button_label and block.settings.button_link %}
                <a
                  href="{{ block.settings.button_link }}"
                  class="fc-btn"
                  style="background-color: {{ btn_bg }}; color: {{ btn_text }};"
                >
                  <span>{{ block.settings.button_label }}</span>
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      {% comment %} Placeholder content if no blocks have been added yet {% endcomment %}
      <p class="fc-placeholder-text">Add cards to get started</p>
    {% endif %}
  </div>
</section>

{% comment %}
  ------------------------------------------------------------------------------
  CSS STYLING
  ------------------------------------------------------------------------------
{% endcomment %}
<style>
  /* Section Wrapper Styles */
  .fc-product-cards-section {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    transition: background-color 0.3s ease;
  }

  /* Container for max width and centering */
  .fc-product-cards-container {
    max-width: {{section.settings.max_container}}px;
    margin: 0 auto;
  }

  /* Grid Layout: Uses CSS Grid for flexible, responsive columns */
  .fc-cards-grid {
    display: grid;
    /* auto-fit creates columns that are at least 320px wide */
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    width: 100%;
  }

  /* Individual Card Styling */
  .fc-card {
    border-radius: 20px;
    box-shadow: 0 5px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%; /* Ensures all cards in a row have equal height */
  }

  /* Hover effect for the entire card */
  .fc-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 25px rgba(0, 0, 0, 0.15);
  }

  /* Image Aspect Ratio Container */
  .fc-image-container {
    position: relative;
    width: 100%;
    /* Creates a 4:3 aspect ratio (75% of width) */
    padding-bottom: 75%;
    overflow: hidden;
    background: #f0f0f0;
  }

  /* Image object-fit styling */
  .fc-image-container img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  /* Placeholder styling when no image is uploaded */
  .fc-image-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e0e7ff 0%, #f3e8ff 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 14px;
  }

  /* Image zoom effect on card hover */
  .fc-card:hover .fc-image-container img {
    transform: scale(1.05);
  }

  /* Badge/Tag Positioning and Pulse Animation */
  .fc-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
  }

  /* Keyframe animation for subtle pulsing effect */
  @keyframes fc-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  .fc-badge-icon {
    width: 100px;
    height: 30px;
    background: linear-gradient(135deg, #ffffff 0%, #ffffff 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: #000000;
    font-weight: bold;
  }

  /* Card Content Text Area */
  .fc-content {
    padding: 30px;
    flex: 1; /* Allows content area to fill remaining vertical space */
    display: flex;
    flex-direction: column;
  }

  /* Text Styling */
  .fc-doctor-name {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .fc-title {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 15px;
    line-height: 1.3;
  }

  .fc-description {
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: auto; /* Pushes the button to the bottom */
    padding-bottom: 20px;
  }

  /* Button Styling */
  .fc-btn {
    display: inline-block;
    width: 100%;
    border: none;
    padding: 14px 20px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    text-align: center;
    text-decoration: none;
    font-family: inherit;
  }

  /* Button subtle ripple effect on hover using ::before pseudo-element */
  .fc-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .fc-btn:hover::before {
    width: 300px;
    height: 300px;
  }

  .fc-btn:hover {
    transform: translateY(-2px); /* Lift button slightly */
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  }

  .fc-btn:active {
    transform: translateY(0);
  }

  .fc-btn span {
    position: relative;
    z-index: 1; /* Ensures text is above the ripple effect */
  }

  /* Placeholder text style */
  .fc-placeholder-text {
    text-align: center;
    color: #999;
    padding: 40px 20px;
    font-size: 16px;
  }

  /* ---------------------------------- */
  /* Responsive Design Media Queries */
  /* ---------------------------------- */

  /* Tablet (1024px) Adjustments */
  @media (max-width: 1024px) {
    .fc-cards-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }
  }

  /* Mobile (768px) Adjustments */
  @media (max-width: 768px) {
    .fc-product-cards-section {
      /* Dynamic padding reduction for mobile */
      padding: {{ section.settings.padding_top | divided_by: 1.5 | round }}px 16px {{ section.settings.padding_bottom | divided_by: 1.5 | round }}px;
    }

    .fc-cards-grid {
      /* Stack cards vertically on mobile */
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .fc-card {
      max-width: 100%;
    }

    .fc-content {
      padding: 24px;
    }

    .fc-title {
      font-size: 20px;
    }

    .fc-description {
      font-size: 14px;
    }
  }

  /* Small Mobile (480px) Adjustments */
  @media (max-width: 480px) {
    .fc-product-cards-section {
      padding: 20px 12px;
    }

    .fc-cards-grid {
      gap: 16px;
    }

    .fc-badge {
      width: 60px;
      height: 60px;
    }

    .fc-badge-icon {
      /* Smaller badge text/icon */
      width: 44px;
      height: 44px;
      font-size: 20px;
    }

    .fc-content {
      padding: 20px;
    }

    .fc-doctor-name {
      font-size: 11px;
    }

    .fc-title {
      font-size: 18px;
      margin-bottom: 12px;
    }

    .fc-description {
      font-size: 13px;
      margin-bottom: 15px;
      padding-bottom: 15px;
    }

    .fc-btn {
      padding: 12px 16px;
      font-size: 14px;
    }
  }
</style>

{% comment %}
  ------------------------------------------------------------------------------
  SHOPIFY SCHEMA (Theme Editor Settings)
  ------------------------------------------------------------------------------
  Defines the editable settings and repeatable blocks for the customizer.
{% endcomment %}
{% schema %}
{
  "name": "Featured Cards",
  "settings": [
    {
      "type": "range",
      "id": "max_container",
      "min": 1100,
      "max": 1800,
      "step": 10,
      "unit": "px",
      "label": "Container",
      "default": 1320
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card Item",
      "limit": 6 /* Maximum number of cards allowed in the section */,
      "settings": [
        { "type": "image_picker", "id": "card_image", "label": "Card Image" },
        { "type": "text", "id": "badge_title", "label": "Badge Title", "default": "Title" },
        { "type": "text", "id": "sub_heading", "label": "Sub Heading", "default": "Featured Product" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Card Title" },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Add a compelling description for your product or service here."
        },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "View Products" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "checkbox", "id": "show_badge", "label": "Show badge", "default": true },
        {
          "type": "color_scheme",
          "id": "card_color_scheme",
          "label": "Color Scheme",
          "default": "scheme-2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Cards",
      "category": "Custom",
      "blocks": [{ "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
