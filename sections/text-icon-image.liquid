{% comment %}
  Get the color from the color scheme
{% endcomment %}

{% assign background_color = section.settings.color_scheme.settings.background %}
{% assign text_color = section.settings.color_scheme.settings.text %}
{% assign sub_heading_color = section.settings.color_scheme.settings.subtext %}
{% assign button_bg = section.settings.color_scheme.settings.button %}
{% assign button_label = section.settings.color_scheme.settings.button_label %}
{% assign desc_text = section.settings.color_scheme.settings.heading_text %}
{%- style -%}
  .tiwi-section{
    background-color: {{background_color}};
  }
    .optimum-quality-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      display: flex;
      align-items: center;
      gap: 80px;
      max-width: 1320px;
      margin: 0 auto;

    }

    .optimum-quality-{{ section.id }} .optimum-quality__image {
      flex: 1;
      border-radius: 20px;
      overflow: hidden;
    }

    .optimum-quality-{{ section.id }} .optimum-quality__image img {
      width: 100%;
      height: auto;
      display: block;
    }

    .optimum-quality-{{ section.id }} .optimum-quality__content {
      flex: 1;
    }

    .optimum-quality-{{ section.id }} .optimum-quality__title {
      font-size: 36px;
      font-weight: bold;
      margin-bottom: 40px;
      color:{{text_color}};;
    }

    .optimum-quality-{{ section.id }} .optimum-quality__features {
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .optimum-quality-{{ section.id }} .optimum-quality__feature {
      display: flex;
      gap: 15px;
    }

    .optimum-quality-{{ section.id }} .optimum-quality__feature-icon {
      width: 44px;
      height: 44px;
      flex-shrink: 0;
    }

    .optimum-quality-{{ section.id }} .optimum-quality__feature-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .optimum-quality-{{ section.id }} .optimum-quality__feature-text h3 {
      font-size: 18px;
      font-weight: 600;
      margin: 0 0 8px;
      color: {{sub_heading_color}};
    }

    .optimum-quality-{{ section.id }} .optimum-quality__feature-text p {
      font-size: 14px;
      margin: 0;
      color: {{desc_text}};
    }

    .optimum-quality-{{ section.id }} .optimum-quality__button {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background:{{button_bg}};
      color: {{button_label}};
      padding: 12px 24px;
      border-radius: 5px;
      text-decoration: none;
      margin-top: 30px;
      transition: all 0.3s;
      font-weight: bold;
    }

    .optimum-quality-{{ section.id }} .optimum-quality__button:hover {
      background: rgba(var(--color-button), 0.8);
      transform: translateY(-2px);
    }

    .optimum-quality-{{ section.id }} .optimum-quality__button svg path {
      fill: {{button_label}};
    }

    @media screen and (max-width: 768px) {
      .optimum-quality-{{ section.id }} {
        flex-direction: column;
      }

      .optimum-quality-{{ section.id }} .optimum-quality__image,
      .optimum-quality-{{ section.id }} .optimum-quality__content {
        width: 100%;
      }
    }
{%- endstyle -%}

<section class="tiwi-section">
  <div class="optimum-quality-{{ section.id }} color-{{ section.settings.color_scheme }}">
    <div class="optimum-quality__image">
      <img
        src="{{ section.settings.main_image | img_url: 'master' }}"
        alt="{{ section.settings.main_image.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.main_image.width }}"
        height="{{ section.settings.main_image.height }}"
      >
    </div>

    <div class="optimum-quality__content">
      <h2 class="optimum-quality__title">{{ section.settings.title }}</h2>

      <div class="optimum-quality__features">
        {% for block in section.blocks %}
          <div class="optimum-quality__feature">
            <div class="optimum-quality__feature-icon">
              <img
                src="{{ block.settings.icon | img_url: 'small' }}"
                alt="{{ block.settings.heading | escape }}"
                loading="lazy"
                width="24"
                height="24"
              >
            </div>
            <div class="optimum-quality__feature-text">
              <h3>{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endfor %}
      </div>

      <a href="{{ section.settings.button_link }}" class="optimum-quality__button">
        {{ section.settings.button_text }}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 4L10.59 5.41L16.17 11H4V13H16.17L10.59 18.59L12 20L20 12L12 4Z" fill="currentColor"/>
        </svg>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text Icon Image",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "This is Heading"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Feature Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Card Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Praesent in aliquam sed malesuada sollicitudin dia. Nulla eras condimentum"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Icon Image",
      "category": "Custom",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
