{% comment %}
  Get color values from the color scheme
{% endcomment %}
{% assign background_color = section.settings.color_scheme.settings.background %}
{% assign text_color = section.settings.color_scheme.settings.text %}
{% assign sub_heading_color = section.settings.color_scheme.settings.subtext %}
{% assign button_bg = section.settings.color_scheme.settings.button %}
{% assign button_label = section.settings.color_scheme.settings.button_label %}
{% assign desc_text = section.settings.color_scheme.settings.heading_text %}

{% comment %} Html skeleton for the section {% endcomment %}
<section class="tii-section">
  <div class="text-icon-image-{{ section.id }}">
    <!-- LEFT: TEXT CONTENT -->
    <div class="tii-content">
      <h2 class="tii-title">{{ section.settings.title }}</h2>

      <div class="tii-features">
        {% for block in section.blocks %}
          <div class="tii-feature">
            <div class="tii-feature-icon">
              <img
                src="{{ block.settings.icon | img_url: 'small' }}"
                alt="{{ block.settings.heading | escape }}"
                width="200"
                height="200"
              >
            </div>
            <div class="tii-feature-text">
              <h3>{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="tii-button">
          {{ section.settings.button_text }}
          <svg width="20" height="20" viewBox="0 0 24 24">
            <path fill="{{ button_label }}" d="M12 4L10.59 5.41L16.17 11H4V13H16.17L10.59 18.59L12 20L20 12L12 4Z"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <!-- RIGHT: IMAGE -->
    <div class="tii-image">
      <img
        src="{{ section.settings.main_image | img_url: 'master' }}"
        alt="{{ section.settings.main_image.alt | escape }}"
        width="400"
        height="400"
      >
    </div>
  </div>
</section>
{% comment %} Style for the section {% endcomment %}
{%- style -%}
  .tii-section {
    background-color: {{ background_color }};
  }

  .text-icon-image-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    display: flex;
    align-items: center;
    gap: 60px;
    max-width: {{section.settings.max_width}}px;
    margin: 0 auto;
  }

  /* Image on the right */
  .text-icon-image-{{ section.id }} .tii-content {
    flex: 1;
  }

  .text-icon-image-{{ section.id }} .tii-image {
    flex: 1;
    border-radius: 20px;
    overflow: hidden;
  }

  .text-icon-image-{{ section.id }} .tii-image img {
    width: 100%;
    display: block;
  }

  .text-icon-image-{{ section.id }} .tii-title {
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 32px;
    color: {{ text_color }};
  }

  .text-icon-image-{{ section.id }} .tii-features {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .text-icon-image-{{ section.id }} .tii-feature {
    display: flex;
    gap: 16px;
  }

  .text-icon-image-{{ section.id }} .tii-feature-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .text-icon-image-{{ section.id }} .tii-feature-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .text-icon-image-{{ section.id }} .tii-feature-text h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 6px 0;
    color: {{ sub_heading_color }};
  }

  .text-icon-image-{{ section.id }} .tii-feature-text p {
    font-size: 14px;
    margin: 0;
    color: {{ desc_text }};
  }

  .text-icon-image-{{ section.id }} .tii-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 32px;
    padding: 12px 24px;
    border-radius: 6px;
    background: {{ button_bg }};
    color: {{ button_label }};
    text-decoration: none;
    font-weight: 600;
    transition: 0.25s;
  }

  .text-icon-image-{{ section.id }} .tii-button:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  @media screen and (max-width: 768px) {
    .text-icon-image-{{ section.id }} {
      flex-direction: column-reverse;
      gap: 40px;
    }

    .text-icon-image-{{ section.id }} .tii-content,
    .text-icon-image-{{ section.id }} .tii-image {
      width: 100%;
    }
  }
{%- endstyle -%}
{% comment %} Schema for the section {% endcomment %}
{% schema %}
{
  "name": "Text Icon Image",
  "settings": [
    {
      "type": "range",
      "id": "max_width",
      "min": 1100,
      "max": 1800,
      "step": 10,
      "unit": "px",
      "label": "Container",
      "default": 1320
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Padding Bottom",
      "default": 40
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color Scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "main_image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Heading", "default": "This is Heading" },
    { "type": "text", "id": "button_text", "label": "Button Label", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Feature Icon" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Card Title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Default description text goes here." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Icon Image",
      "category": "Custom",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
